<?xml version="1.0"?>
<!-- Slalom pylon: white inflatable cylinder with the blue dot rosette, rounded top.
     Textures are crops of our own MEBC 2026 photos (slalom_buoy.png). Sizes are estimates from photos: correct them if you know the real ones.
     Static: it stays where it is spawned (no waves). Water surface = z 0. -->
<sdf version="1.9">
  <model name="slalom_buoy">
    <static>true</static>
    <link name="link">
      <visual name="body"><pose>0 0 0.45 0 0 0</pose><geometry><cylinder><radius>0.35</radius><length>1.3</length></cylinder></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>1 1 1 1</diffuse><specular>0.1 0.1 0.1 1</specular><pbr><metal><albedo_map>/ws/src/boat/sim_models/textures/slalom_buoy.png</albedo_map><roughness>0.8</roughness><metalness>0.0</metalness></metal></pbr></material></visual>
      <collision name="body_col"><pose>0 0 0.45 0 0 0</pose><geometry><cylinder><radius>0.35</radius><length>1.3</length></cylinder></geometry></collision>
      <visual name="dome"><pose>0 0 1.1 0 0 0</pose><geometry><sphere><radius>0.35</radius></sphere></geometry><material><ambient>0.93 0.93 0.92 1</ambient><diffuse>0.93 0.93 0.92 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      <collision name="dome_col"><pose>0 0 1.1 0 0 0</pose><geometry><sphere><radius>0.35</radius></sphere></geometry></collision>
    </link>
  </model>
</sdf>
