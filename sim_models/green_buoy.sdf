<?xml version="1.0"?>
<!-- Green inflatable marker (ring version, MARK SET BOT): stacked green rings on a blue base.
     Textures are crops of our own MEBC 2026 photos (green_buoy_rings.png). Sizes are estimates from photos: correct them if you know the real ones.
     Static: it stays where it is spawned (no waves). Water surface = z 0. -->
<sdf version="1.9">
  <model name="green_buoy">
    <static>true</static>
    <link name="link">
      <visual name="base"><pose>0 0 0.05 0 0 0</pose><geometry><cylinder><radius>1.0</radius><length>0.35</length></cylinder></geometry><material><ambient>0.13 0.32 0.72 1</ambient><diffuse>0.13 0.32 0.72 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      <collision name="base_col"><pose>0 0 0.05 0 0 0</pose><geometry><cylinder><radius>1.0</radius><length>0.35</length></cylinder></geometry></collision>
      <visual name="rings"><pose>0 0 0.77 0 0 0</pose><geometry><cylinder><radius>1.1</radius><length>1.1</length></cylinder></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>1 1 1 1</diffuse><specular>0.1 0.1 0.1 1</specular><pbr><metal><albedo_map>/ws/src/boat/sim_models/textures/green_buoy_rings.png</albedo_map><roughness>0.8</roughness><metalness>0.0</metalness></metal></pbr></material></visual>
      <collision name="rings_col"><pose>0 0 0.77 0 0 0</pose><geometry><cylinder><radius>1.1</radius><length>1.1</length></cylinder></geometry></collision>
    </link>
  </model>
</sdf>
