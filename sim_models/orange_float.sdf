<?xml version="1.0"?>
<!-- Orange dock float: bright red-orange ball.
     Textures are crops of our own MEBC 2026 photos (orange_float.png). Sizes are estimates from photos: correct them if you know the real ones.
     Static: it stays where it is spawned (no waves). Water surface = z 0. -->
<sdf version="1.9">
  <model name="orange_float">
    <static>true</static>
    <link name="link">
      <visual name="ball"><pose>0 0 0.12 0 0 0</pose><geometry><sphere><radius>0.25</radius></sphere></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>1 1 1 1</diffuse><specular>0.1 0.1 0.1 1</specular><pbr><metal><albedo_map>/ws/src/boat/sim_models/textures/orange_float.png</albedo_map><roughness>0.8</roughness><metalness>0.0</metalness></metal></pbr></material></visual>
      <collision name="ball_col"><pose>0 0 0.12 0 0 0</pose><geometry><sphere><radius>0.25</radius></sphere></geometry></collision>
    </link>
  </model>
</sdf>
