      <visual name="shackle4"><pose>0 0.000 2.020 1.571 0 0</pose><geometry><box><size>0.06 0.07 0.07</size></box></geometry><material><ambient>0.38 0.38 0.4 1</ambient><diffuse>0.38 0.38 0.4 1</diffuse><specular>0.15 0.15 0.15 1</specular></material></visual>
      <visual name="shackle5"><pose>0 -0.065 2.007 1.963 0 0</pose><geometry><box><size>0.06 0.07 0.07</size></box></geometry><material><ambient>0.38 0.38 0.4 1</ambient><diffuse>0.38 0.38 0.4 1</diffuse><specular>0.15 0.15 0.15 1</specular></material></visual>
      <visual name="shackle6"><pose>0 -0.120 1.970 2.356 0 0</pose><geometry><box><size>0.06 0.07 0.07</size></box></geometry><material><ambient>0.38 0.38 0.4 1</ambient><diffuse>0.38 0.38 0.4 1</diffuse><specular>0.15 0.15 0.15 1</specular></material></visual>
      <visual name="shackle7"><pose>0 -0.157 1.915 2.749 0 0</pose><geometry><box><size>0.06 0.07 0.07</size></box></geometry><material><ambient>0.38 0.38 0.4 1</ambient><diffuse>0.38 0.38 0.4 1</diffuse><specular>0.15 0.15 0.15 1</specular></material></visual>
      <visual name="shackle8"><pose>0 -0.170 1.850 3.142 0 0</pose><geometry><box><size>0.06 0.07 0.07</size></box></geometry><material><ambient>0.38 0.38 0.4 1</ambient><diffuse>0.38 0.38 0.4 1</diffuse><specular>0.15 0.15 0.15 1</specular></material></visual>
      <visual name="shackle_leg_l"><pose>0 0.17 1.81 0 0 0</pose><geometry><box><size>0.06 0.06 0.1</size></box></geometry><material><ambient>0.38 0.38 0.4 1</ambient><diffuse>0.38 0.38 0.4 1</diffuse><specular>0.15 0.15 0.15 1</specular></material></visual>
      <visual name="shackle_leg_r"><pose>0 -0.17 1.81 0 0 0</pose><geometry><box><size>0.06 0.06 0.1</size></box></geometry><material><ambient>0.38 0.38 0.4 1</ambient><diffuse>0.38 0.38 0.4 1</diffuse><specular>0.15 0.15 0.15 1</specular></material></visual>
      <visual name="ball"><pose>0.55 0.35 1.06 0 0 0</pose><geometry><sphere><radius>0.13</radius></sphere></geometry><material><ambient>0.95 0.25 0.08 1</ambient><diffuse>0.95 0.25 0.08 1</diffuse><specular>0.15 0.15 0.15 1</specular></material></visual>
    </link>
  </model>
</sdf>
